# Text files are stored with LF line endings on every machine.
* text=auto eol=lf

# Binary files: never diffed or merged as text.
*.png binary
*.jpg binary
*.jpeg binary
*.dcm binary
*.wasm binary
*.spinecase binary
*.woff2 binary
*.bin binary

# Written by tools, never edited by hand: collapsed in review diffs.
app/src/shapes/generated/** linguist-generated=true
docs/contracts/case-file-v1.schema.json linguist-generated=true
Cargo.lock linguist-generated=true
pnpm-lock.yaml linguist-generated=true
